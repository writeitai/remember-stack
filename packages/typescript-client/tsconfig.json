{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "ESNext.Disposable"],
    "strict": true, "noUncheckedIndexedAccess": true,
    "esModuleInterop": true, "resolveJsonModule": true, "skipLibCheck": true,
    "declaration": true
  },
  "include": ["src/**/*.ts"]
}
