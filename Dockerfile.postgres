FROM pgvector/pgvector:0.8.6-pg18-trixie@sha256:78bf48b801e792f99e3ac62b5036fd3876e9be48afda16c1e331af1c75ceb2ff

ARG TARGETARCH
ARG PG_TEXTSEARCH_VERSION=1.3.1

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl postgresql-18-partman unzip; \
    case "${TARGETARCH}" in \
      amd64) pg_textsearch_sha256="9f256dc7f082235d8fead7df361427e0a0344a9ee64662f3b50449eeb90bbc7c" ;; \
      arm64) pg_textsearch_sha256="62b6351a320c82dcf802d15704b6c282f2eb03df29ed9906d5c56fafc6c21b83" ;; \
      *) echo "unsupported target architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    archive="/tmp/pg-textsearch.zip"; \
    curl --fail --location --silent --show-error \
      "https://github.com/timescale/pg_textsearch/releases/download/v${PG_TEXTSEARCH_VERSION}/pg-textsearch-v${PG_TEXTSEARCH_VERSION}-pg18-${TARGETARCH}.zip" \
      --output "${archive}"; \
    echo "${pg_textsearch_sha256}  ${archive}" | sha256sum --check; \
    unzip -q "${archive}" -d /tmp/pg-textsearch; \
    apt-get install -y --no-install-recommends /tmp/pg-textsearch/*.deb; \
    rm -rf /tmp/pg-textsearch "${archive}" /var/lib/apt/lists/*
