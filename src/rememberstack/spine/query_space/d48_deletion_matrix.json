    {
      "forbidden_identifiers": "The lineage id and every identifier derived from it: its versions, representations, sections, chunks, claims, mentions, cross-references, testimony-currency events, the entity whose only provenance it was, and the fact whose only evidence lineage it was.",
      "mutation": "Set documents.deleted_at on the fixture lineage.",
      "summary": "A live document lineage is forgotten.",
      "target_id": "lineage"
    },
    {
      "forbidden_identifiers": "The version id and every identifier derived from it: its representation, sections, chunks, claims, and mentions. The facts those claims evidenced keep their surviving historical provenance and are deliberately not forbidden.",
      "mutation": "Set document_versions.deleted_at on the fixture version.",
      "summary": "One non-current version of a live lineage is tombstoned.",
      "target_id": "version"
    },
    {
      "forbidden_identifiers": "The superseded representation id and the sections and chunks cut from it. The fixture lineage carries no claims, so no testimony legitimately outlives the reading and the forbidden set stays global.",
      "mutation": "Insert a new ready representation, point the version's current representation at it, and leave the previous reading in place.",
      "summary": "The current ready reading of a live version is superseded.",
      "target_id": "representation"
    },
    {
      "forbidden_identifiers": "The claim id. The fact it evidenced keeps its association row and stays visible with a reduced count, which is the D54 behaviour rather than a leak.",
      "mutation": "Delete the claim row and its chunk occurrences.",
      "summary": "One claim is purged from the testimony record.",
      "target_id": "claim"
    },
    {
      "forbidden_identifiers": "The fact id, which must disappear from the fact relations, the evidence bridge, the contradiction and graph projections, and the change feed.",
      "mutation": "Delete the fact's relation or observation evidence rows.",
      "summary": "Every evidence lineage of one fact is removed.",
      "target_id": "fact_provenance"
    },
    {
      "forbidden_identifiers": "The cited lineage id and its derived identifiers. The citing page stays visible; only the citation leaves, which is what proves a chunk-content hash locator cannot authorize a read on its own.",
      "mutation": "Set documents.deleted_at on the cited lineage.",
      "summary": "The lineage a knowledge page cites is forgotten.",
      "target_id": "k_target"
    }
  ]
}
